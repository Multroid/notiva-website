# Notiva Marketing Website - Environment Variables
# Copy this file to .env.local for local development
# For AWS Amplify, set these in the Amplify Console Environment Variables

# ============================================
# REQUIRED - Application URLs
# ============================================

# Base URL for the marketing website (where this app is deployed)
NEXT_PUBLIC_MARKETING_URL=https://notiva.de

# Consumer app URL (where users log in and use the app)
NEXT_PUBLIC_CONSUMER_APP_URL=https://app.notiva.de

# NextAuth configuration
NEXTAUTH_URL=https://notiva.de
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl

# Cookie domain for cross-subdomain authentication
COOKIE_DOMAIN=.notiva.de

# ============================================
# DATABASE (if marketing site needs DB access)
# ============================================

# Supabase Database URLs (if needed)
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# ============================================
# EMAIL SERVICE (Resend)
# ============================================

RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@notiva.de

# ============================================
# STRIPE (if marketing handles payments)
# ============================================

STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# ANALYTICS (Optional)
# ============================================

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# NODE ENVIRONMENT
# ============================================

NODE_ENV=production
