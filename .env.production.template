# Production Environment Variables for AWS Amplify
# This file contains the production environment variables
# Use scripts/deploy-env-vars.sh to deploy these to AWS Amplify

# ============================================
# AMPLIFY CONFIGURATION
# ============================================
AMPLIFY_DIFF_DEPLOY=false
AMPLIFY_MONOREPO_APP_ROOT=.

# ============================================
# DOMAIN & COOKIES
# ============================================
COOKIE_DOMAIN=.notiva.de

# ============================================
# ENCRYPTION & SECURITY
# ============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here
NEXTAUTH_SECRET=your-nextauth-secret-here

# ============================================
# LOGO.DEV API
# ============================================
LOGO_DEV_SECRET_KEY=your-logo-dev-key-here

# ============================================
# PUBLIC URLs
# ============================================
NEXT_PUBLIC_BUSINESS_APP_URL=https://business.notiva.de
NEXT_PUBLIC_CONSUMER_APP_URL=https://app.notiva.de
NEXT_PUBLIC_LOGO_DEV_TOKEN=your-public-logo-dev-token
NEXT_PUBLIC_MARKETING_URL=https://notiva.de

# ============================================
# LIVE UPDATES (Amplify CLI, Node.js)
# ============================================
_LIVE_UPDATES=[{"name":"Node.js version","pkg":"node","type":"nvm","version":"20"},{"name":"Amplify CLI","pkg":"@aws-amplify/cli","type":"npm","version":"latest"}]

# ============================================
# DATABASE (Supabase/PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public&pgbouncer=true&connection_limit=1&pool_timeout=0
DIRECT_URL=postgresql://user:password@host:5432/database?schema=public&sslmode=require

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
EMAIL_FROM=Notiva <notifications@notifications.notiva.de>
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
NEXTAUTH_URL=https://notiva.de

# ============================================
# STRIPE PAYMENTS
# ============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
